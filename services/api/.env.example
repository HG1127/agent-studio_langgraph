# This application is local-development only until authentication and tenant isolation are implemented.
AGENT_STUDIO_DB_PATH=.local/agent_studio.sqlite3
# Optional dedicated LangGraph checkpoint database (otherwise derived from DB_PATH)
# AGENT_STUDIO_CHECKPOINT_PATH=.local/agent_studio.checkpoints.sqlite3
# SQLite local development only; external write tools and public access are disabled.
LANGGRAPH_STRICT_MSGPACK=true
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
# Never commit real keys. Use environment variables or a secret manager.
