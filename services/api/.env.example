# Local prototype authentication exists but production tenant/security validation is NOT complete.
AGENT_STUDIO_DB_PATH=.local/agent_studio.sqlite3
# The only active application backend in V0.5 is sqlite; 'postgres' refuses to start.
STUDIO_DATABASE_BACKEND=sqlite
# PostgreSQL migrations use STUDIO_POSTGRES_ADMIN_URL (never in this file/repo).
# PostgreSQL and pgvector schema are prepared; API/Worker adapter switch awaits real DB tests.
# Optional dedicated LangGraph checkpoint database (otherwise derived from DB_PATH)
# AGENT_STUDIO_CHECKPOINT_PATH=.local/agent_studio.checkpoints.sqlite3
# SQLite local development only; external write tools and public access are disabled.
LANGGRAPH_STRICT_MSGPACK=true
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
# Never commit real keys. Use environment variables or a secret manager.
